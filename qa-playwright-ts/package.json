{
  "name": "qa-playwright-ts",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright (TypeScript) UI tests for https://practicesoftwaretesting.com",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen --test-id-attribute=data-test https://practicesoftwaretesting.com",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
